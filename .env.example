# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of your local Ollama server (default is fine unless you changed it)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model — must be pulled first: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chat/generation model — must be pulled first: ollama pull llama3.2
OLLAMA_CHAT_MODEL=llama3.2

# ── Chunking ──────────────────────────────────────────────────────────────────
# Max characters per chunk (increase for more context, decrease for precision)
CHUNK_SIZE=500

# Characters of overlap between adjacent chunks (prevents boundary information loss)
CHUNK_OVERLAP=50

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of chunks to retrieve per query (more = more context for the LLM)
TOP_K_RESULTS=4

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Directory where ChromaDB will persist its vector store data
CHROMA_PERSIST_DIR=./chroma_db
